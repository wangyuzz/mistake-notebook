# Database and deployment settings require a server restart.
# Empty DATABASE_URL uses persistent local multi-user JSON storage.
DATABASE_URL=
# Example: postgresql://shiti:change-me@localhost:5432/shiti
DATABASE_SSL=false
PORT=3001
HOST=127.0.0.1
# Docker Compose: generate these with sh deploy/init.sh on a fresh Linux server.
# Use a hexadecimal password to avoid URL-encoding in the database connection.
POSTGRES_PASSWORD=
APP_BIND_IP=0.0.0.0
APP_PORT=3001
COOKIE_SECURE=false
# Optional first-admin setup token. Remove after initialization if desired.
SETUP_TOKEN=
# Keep this stable and back it up. Empty = generated data/settings.key.
SETTINGS_ENCRYPTION_KEY=
# Initial defaults only. After the administrator saves AI settings, the database settings take precedence.
AI_API_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=
AI_RECOGNITION_MODEL=
AI_TIMEOUT_MS=90000
